generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SavedWord {
  id          String   @id @default(cuid())
  word        String
  meaning     String
  hin         String   @default("")
  exampleEng  String   @default("")
  exampleHin  String   @default("")
  userId      String
  createdAt   DateTime @default(now())

  @@unique([userId, word])
}
